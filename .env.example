# vision_race 环境变量示例
# 复制为 .env 并填写真实 key（.env 已被 gitignore，不会提交）

# 竞速阵容文件路径（默认 ~/.modlens/race.json）
VISION_RACE_CONFIG=

# 竞速超时（毫秒，默认 120000）
VISION_RACE_TIMEOUT_MS=

# 梯队间隔（毫秒，默认 0 = 全员同时起跑）
VISION_RACE_STAGGER_MS=

# modlens CLI 路径（默认 DSH 安装位置的 @liustack/modlens/dist/main.js）
# 独立部署时可指定自己安装的 modlens CLI
MODLENS_CLI=